{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seaworld008/Commonly-used-high-value-skills/schemas/provenance-v2.json",
  "title": "High Value Skills provenance mapping",
  "type": "object",
  "required": [
    "schema_version",
    "video",
    "official_references",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "video": {
      "type": "object"
    },
    "official_references": {
      "type": "array"
    },
    "install_policy": {
      "$ref": "#/$defs/installPolicy"
    },
    "bundle": {
      "$ref": "#/$defs/bundleIdentity"
    },
    "bundle_inventory": {
      "$ref": "#/$defs/bundleInventory"
    },
    "installer": {
      "$ref": "#/$defs/installer"
    },
    "slsa_provenance": {
      "$ref": "#/$defs/slsaProvenance"
    },
    "commit_coherence": {
      "$ref": "#/$defs/commitCoherence"
    },
    "verification_attempts": {
      "type": "array"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/v2Entry"
      }
    }
  },
  "$defs": {
    "legacyEntry": {
      "type": "object",
      "required": [
        "video_name",
        "normalized_slug",
        "status",
        "repo_skill",
        "source",
        "notes"
      ]
    },
    "v2Entry": {
      "allOf": [
        {
          "$ref": "#/$defs/legacyEntry"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "sync_mode",
            "origins",
            "managed_files"
          ],
          "properties": {
            "kind": {
              "enum": [
                "mirror",
                "overlay",
                "composite",
                "bundle",
                "snapshot",
                "in_house",
                "reference_only"
              ]
            },
            "sync_mode": {
              "enum": [
                "replace",
                "monitor",
                "local-only",
                "archived",
                "manual"
              ]
            },
            "origins": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/origin"
              }
            },
            "managed_files": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/managedFile"
              }
            },
            "composition": {
              "$ref": "#/$defs/composition"
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "required": [
        "repo",
        "path",
        "license",
        "sync_mode",
        "artifacts",
        "tracking"
      ],
      "properties": {
      "repo": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]+$"
        },
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "sync_mode": {
          "enum": [
            "replace",
            "monitor",
            "local-only",
            "archived",
            "manual"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "tracking": {
          "$ref": "#/$defs/tracking"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "repo": {
                "const": "local-repo/curation"
              }
            },
            "required": [
              "repo"
            ]
          },
          "then": {
            "properties": {
              "license": {
                "type": "null"
              },
              "sync_mode": {
                "const": "local-only"
              },
              "tracking": {
                "allOf": [
                  {
                    "$ref": "#/$defs/tracking"
                  },
                  {
                    "properties": {
                      "channel": {
                        "const": "local"
                      },
                      "ref": {
                        "const": "local"
                      },
                      "resolved_commit": {
                        "type": "null"
                      },
                      "path_commit": {
                        "type": "null"
                      }
                    },
                    "not": {
                      "required": [
                        "license_checkpoint"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "target": {
          "$ref": "#/$defs/relativePath"
        },
        "type": {
          "enum": [
            "file",
            "directory"
          ]
        }
      }
    },
    "managedFile": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "owner",
        "mode"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        }
      },
      "additionalProperties": false
    },
    "tracking": {
      "type": "object",
      "required": [
        "channel",
        "ref",
        "resolved_commit",
        "path_commit",
        "content_sha256",
        "last_checked_at",
        "last_synced_at"
      ],
      "properties": {
        "channel": {
          "enum": [
            "latest_release",
            "default_branch",
            "canary",
            "fixed_ref",
            "local"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "path_commit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "content_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "last_checked_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "last_synced_at": {
          "$ref": "#/$defs/nullableDate"
        },
        "license_checkpoint": {
          "$ref": "#/$defs/licenseCheckpoint"
        }
      }
    },
    "licenseCheckpoint": {
      "type": "object",
      "required": [
        "path",
        "blob_sha",
        "content_sha256",
        "spdx",
        "resolved_commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "blob_sha": {
          "$ref": "#/$defs/commit"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit": {
          "$ref": "#/$defs/commit"
        },
        "api_spdx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": [
        "depends_on",
        "dependency_lock"
      ],
      "properties": {
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "dependency_lock": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
      "source_package": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]+$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "skill"
          ],
          "not": {
            "required": [
              "source_package"
            ]
          }
        },
        {
          "required": [
            "source_package"
          ],
          "not": {
            "required": [
              "skill"
            ]
          }
        }
      ]
    },
  "relativePath": {
    "type": "string",
    "minLength": 1,
    "pattern": "^(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
  },
    "nullableCommit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "installPolicy": {
      "type": "object",
      "required": [
        "mode",
        "default_install"
      ],
      "properties": {
        "mode": {
          "const": "explicit_only"
        },
        "default_install": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "bundleIdentity": {
      "type": "object",
      "required": [
        "id",
        "optional",
        "state_root",
        "isolated_from"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "optional": {
          "type": "boolean"
        },
        "state_root": {
          "$ref": "#/$defs/stateRoot"
        },
        "isolated_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "bundle",
              "state_root"
            ],
            "properties": {
              "bundle": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "state_root": {
                "$ref": "#/$defs/stateRoot"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bundleInventory": {
      "type": "object",
      "required": [
        "package_files",
        "skills",
        "agents",
        "commands",
        "runtime_files",
        "runtime_scope",
        "installed_in_repository"
      ],
      "properties": {
        "package_files": {
          "type": "integer",
          "minimum": 0
        },
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_files": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_scope": {
          "type": "string",
          "minLength": 1
        },
        "installed_in_repository": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "installer": {
      "type": "object",
      "required": [
        "registry",
        "package",
        "version",
        "spec",
        "command",
        "tarball_sha256",
        "integrity",
        "npm_shasum",
        "package_files",
        "unpacked_size",
        "git_head",
        "tag_commit"
      ],
      "properties": {
        "registry": {
          "const": "npm"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "pattern": "^npx "
        },
        "tarball_url": {
          "type": "string",
          "format": "uri"
        },
        "tarball_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-"
        },
        "npm_shasum": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "package_files": {
          "type": "integer",
          "minimum": 1
        },
        "unpacked_size": {
          "type": "integer",
          "minimum": 1
        },
        "git_head": {
          "$ref": "#/$defs/commit"
        },
        "tag_commit": {
          "$ref": "#/$defs/commit"
        },
        "git_head_matches_tag": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "slsaProvenance": {
      "type": "object",
      "required": [
        "attestation_url",
        "predicate_type",
        "build_type",
        "subject_name",
        "subject_sha512",
        "source_repository",
        "source_ref",
        "workflow_path",
        "attested_source_commit",
        "builder_id",
        "invocation_id"
      ],
      "properties": {
        "attestation_url": {
          "type": "string",
          "format": "uri"
        },
        "predicate_type": {
          "const": "https://slsa.dev/provenance/v1"
        },
        "build_type": {
          "const": "https://slsa-framework.github.io/github-actions-buildtypes/workflow/v1"
        },
        "subject_name": {
          "type": "string",
          "pattern": "^pkg:npm/"
        },
        "subject_sha512": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{128}$"
        },
        "source_repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/"
        },
        "workflow_path": {
          "$ref": "#/$defs/relativePath"
        },
        "attested_source_commit": {
          "$ref": "#/$defs/commit"
        },
        "builder_id": {
          "type": "string",
          "format": "uri"
        },
        "invocation_id": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "commitCoherence": {
      "type": "object",
      "required": [
        "npm_git_head_relative_to_tag",
        "attested_source_relative_to_tag"
      ],
      "properties": {
        "npm_git_head_relative_to_tag": {
          "$ref": "#/$defs/commitRelation"
        },
        "attested_source_relative_to_tag": {
          "$ref": "#/$defs/commitRelation"
        }
      },
      "additionalProperties": false
    },
    "commitRelation": {
      "type": "object",
      "required": [
        "relation",
        "distance",
        "base_commit",
        "merge_base_commit",
        "ahead_by",
        "behind_by",
        "compare_url"
      ],
      "properties": {
        "relation": {
          "enum": [
            "equal",
            "ancestor_by",
            "descendant_by"
          ]
        },
        "distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "base_commit": {
          "$ref": "#/$defs/commit"
        },
        "merge_base_commit": {
          "$ref": "#/$defs/commit"
        },
        "ahead_by": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "behind_by": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "compare_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
    },
    "nullableDate": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stateRoot": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
